APP_ENV=production
BFF_ALLOWED_ORIGINS=https://travel.example.com
BFF_REQUIRE_ORIGIN_FOR_ANONYMOUS=true
BFF_SESSION_HMAC_SECRET=replace-with-at-least-32-random-characters
BFF_SESSION_COOKIE=__Host-travelplanner_session
BFF_SESSION_TTL_SECONDS=3600
BFF_BEARER_TOKENS_JSON=[]
BFF_DB_PATH=/var/lib/17travelplanner/bff.sqlite
BFF_USER_RATE_PER_MINUTE=120
BFF_ANON_RATE_PER_MINUTE=30
BFF_GLOBAL_RATE_PER_MINUTE=1200
BFF_UPSTREAM_CONNECT_TIMEOUT_MS=800
BFF_UPSTREAM_TIMEOUT_MS=4000
BFF_UPSTREAM_MAX_RESPONSE_BYTES=5242880
BFF_PROVIDER_CONCURRENCY=8
BFF_CONCURRENCY_LEASE_SECONDS=10
BFF_CACHE_TTL_PLACES_SECONDS=300
BFF_CACHE_TTL_ROUTES_SECONDS=120
BFF_CACHE_TTL_MATRIX_SECONDS=120
BFF_CACHE_TTL_STATIC_MAPS_SECONDS=600
BFF_CIRCUIT_FAILURE_THRESHOLD=5
BFF_CIRCUIT_RESET_SECONDS=30
BFF_MAX_REQUEST_BYTES=65536
BFF_ENABLED_PROVIDERS=google,gaode,tianditu
BFF_CREDENTIAL_VERSION=v1
GOOGLE_MAPS_SERVER_API_KEY=
AMAP_WEB_SERVICE_API_KEY=
TIANDITU_SERVER_API_KEY=
AZURE_MAPS_SUBSCRIPTION_KEY=
